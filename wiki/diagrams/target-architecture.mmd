flowchart TB
    Dev(["Developer (you)"]) -->|"git push"| GH[("GitHub repo")]
    GH -->|"trigger"| Jenkins["Jenkins<br/>CI/CD - Phase 1"]
    Jenkins -->|"build + test + image"| Img["Docker image"]

    subgraph Infra["App infrastructure"]
        direction LR
        Web["TaskBoard web<br/>Django"] -->|"SQL"| DB[("Postgres")]
    end

    Img --> Web
    TF["Terraform<br/>Phase 3"] -.->|"provisions"| Infra
    Ans["Ansible<br/>Phase 4"] -.->|"configures"| Infra

    Web -->|"/metrics"| Prom["Prometheus<br/>Phase 2"]
    Prom --> Graf["Grafana<br/>dashboards - Phase 2"]
    Web -->|"logs"| ELK["ELK stack<br/>Phase 6 (stretch)"]
    DB -->|"SQL connection"| PBI["Power BI<br/>dashboard - Phase 5"]

    Kanban["Agile / Kanban board<br/>Phase 0 + 7"] -.->|"tracks every phase"| Dev

    classDef done fill:#d4edda,stroke:#28a745,color:#155724;
    classDef todo fill:#fff3cd,stroke:#ffc107,color:#856404;
    class Web,DB,Jenkins,Img,Kanban done;
    class TF,Ans,Prom,Graf,ELK,PBI todo;
